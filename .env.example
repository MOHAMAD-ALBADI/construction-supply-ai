# Copy to .env.local and fill in. Never commit real values. (Doc 5 §7)

# --- Public (safe for the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEMO_MODE=true
# Optional brand overrides (defaults live in src/config/brand.ts)
NEXT_PUBLIC_BRAND_NAME_AR=
NEXT_PUBLIC_BRAND_NAME_EN=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_MS=60000
OPENAI_STORE_RESPONSES=false
AGENT_MAX_TOOL_ITERATIONS=8
NEGOTIATION_MAX_ASK_PCT=0.10
DEMO_MODE=true
DEMO_USER_PASSWORD=
